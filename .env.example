# --- Database ---
# Neon Postgres connection string. Required in production/staging.
# If unset, the app and scripts fall back to a local embedded Postgres
# (PGlite) stored on disk — no server install needed for local dev.
DATABASE_URL=

# Directory PGlite writes its local database to when DATABASE_URL is unset.
# Defaults to ".pglite-data" in the project root.
PGLITE_DATA_DIR=

# --- Settings UI (/settings) ---
# Shared password gating /settings/*. All admins currently sign in with
# this one password and self-report their email for the audit trail.
SETTINGS_PASSWORD=
# Secret the settings login session cookie is signed with. Any long random
# string; rotating it invalidates all existing sessions.
SETTINGS_SESSION_SECRET=
# IANA timezone pre-selected when adding a new client. Falls back to
# America/New_York if unset.
DEFAULT_CLIENT_TIMEZONE=

# --- Sync ---
# Verified against the Authorization header Vercel Cron sends on scheduled
# hits to /api/cron/sync (see vercel.json). Any long random string; unset
# means the route always 401s, never means "open".
CRON_SECRET=

# --- Connectors ---
# When set to "fixture", connectors read from fixtures/<platform>/ instead
# of calling the real API. Use this for local dev and tests.
CONNECTOR_MODE=

# --- /insights (AI summary + chat) ---
# Vercel AI Gateway. On a `vercel dev`/deployed project with an OIDC token
# (VERCEL_OIDC_TOKEN, set automatically) this can be left unset; otherwise
# generate a key at vercel.com/[team]/~/ai-gateway/api-keys.
AI_GATEWAY_API_KEY=

# --- lead-dashboard connector ---
# leaman.civsav.com. "Sites" are the locations — account.externalId is a
# site id. Bearer-token key is tied to a CLIENT or ADMIN role on that API;
# CLIENT keys are auto-scoped server-side to their assigned sites.
LEAD_DASHBOARD_API_BASE_URL=
LEAD_DASHBOARD_API_KEY=

# --- google_ads connector ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only needed when the account is accessed through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- meta connector ---
META_GRAPH_API_BASE_URL=
# System user token — does not expire, unlike a user access token.
META_SYSTEM_USER_ACCESS_TOKEN=

# --- search_console and ga4 connectors (same service account) ---
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- ghl connector ---
# GHL Private Integration tokens are location-scoped, not agency-wide --
# confirmed live: even a token with every scope checked gets 403 for any
# location other than the one it was created inside. So this needs one
# GHL_AGENCY_API_KEY__<LABEL> per client location (same shape as
# OpenPhone's per-workspace keys), not a single shared key.
# account.externalId is the GHL locationId for that client.
GHL_API_BASE_URL=
# GHL_AGENCY_API_KEY__<LABEL>=

# --- openphone connector ---
# OpenPhone has no agency/reseller API — a key is scoped to exactly one
# workspace. If every client's number lives in one shared workspace, just
# set OPENPHONE_API_KEY and stop here. If clients live in SEPARATE
# workspaces, leave OPENPHONE_API_KEY unset and instead define one
# OPENPHONE_API_KEY__<LABEL> per workspace (e.g.
# OPENPHONE_API_KEY__NORTHEAST=...); the settings UI will discover numbers
# across all of them and remember which workspace each client's number
# belongs to.
# GET /v1/calls has no bulk mode — it is hard-scoped to one participant's
# 1:1 conversation per query, so fetchCallSummary lists conversations
# active in the sync window first (to discover participants), then fetches
# and combines calls per participant. See client.ts.
OPENPHONE_API_BASE_URL=
OPENPHONE_API_KEY=
# OPENPHONE_API_KEY__<LABEL>=

# --- ahrefs connector ---
# Metered in API units and hard-stops when exhausted for the period.
# Always develop against CONNECTOR_MODE=fixture, never the live API.
# fetchSummary hits /site-explorer/metrics with a single `date` (a
# point-in-time snapshot, not a range) — org_cost/paid_cost come back in
# USD cents, converted in ahrefs/schema.ts's centsToUsd.
AHREFS_API_BASE_URL=
AHREFS_API_TOKEN=
